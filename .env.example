# Embedding backend: sentence-transformers, runs fully local (CPU/MPS/CUDA),
# no API key needed. all-MiniLM-L6-v2 (22M params, 384-dim) embeds the full
# slice in seconds. Qwen3-Embedding-0.6B (Qwen's smallest embedding model)
# also works if set here, but is much slower for no real accuracy gain at
# this dataset size.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Category slice to keep from the raw Amazon 2020 dump. Matched exactly
# against the top-level segment of the Category breadcrumb (e.g. the "Home &
# Kitchen" in "Home & Kitchen | Bedding | ..."). See README for why this
# dataset's actual "Household Cleaning" coverage is too thin to use.
CATEGORY_TOP_LEVEL=Home & Kitchen

# Chroma persistent index location + collection name
CHROMA_DIR=data/chroma_db
CHROMA_COLLECTION=amazon_products_home_kitchen

# --- MCP server (src/mcp_server/) ---

# Transport for `python src/mcp_server/server.py`: stdio (default, for local
# agent-graph process piping) or sse / streamable-http (for a networked
# backend). HTTP host/port only apply to sse/streamable-http.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000

# web.search provider: "serper" (Serper.dev) or "brave" (Brave Search API).
# Only the key for the selected provider is required.
WEB_SEARCH_PROVIDER=serper
SERPER_API_KEY=
BRAVE_API_KEY=

# Comma-separated registrable domains web.search is allowed to return.
# Subdomains of a listed domain are allowed too (e.g. www.amazon.com matches
# amazon.com). Results outside this list, or disallowed by the domain's
# robots.txt for ROBOTS_USER_AGENT, are dropped before reaching the agent.
WEB_SEARCH_ALLOWED_DOMAINS=amazon.com,walmart.com,target.com,bestbuy.com,homedepot.com
ROBOTS_USER_AGENT=AgenticVoiceAssistantBot/1.0

# web.search result cache TTL and rate limit (sliding window).
WEB_SEARCH_CACHE_TTL_SECONDS=120
WEB_SEARCH_RATE_LIMIT_CALLS=20
WEB_SEARCH_RATE_LIMIT_PERIOD_SECONDS=60

# --- Agent graph (src/agents/) ---

# Claude API key for the router/planner/answerer nodes' LLM calls
# (src/agents/llm_client.py). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1024

# --- ASR (src/asr/) ---

# faster-whisper model size (tiny/base/small/medium/large-v3) and backend.
# "small" is a reasonable CPU-latency/accuracy tradeoff for a demo; device
# "auto" picks CUDA/MPS if available, else CPU. compute_type "int8" is the
# fastest CPU option; use "float16" on GPU.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# --- TTS (src/tts/) ---

# Azure Speech resource key/region (portal.azure.com -> Speech resource ->
# Keys and Endpoint) and the neural voice to synthesize with.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-AriaNeural

# --- Backend API (src/api/) ---

# FastAPI service wrapping ASR -> agent graph -> TTS over HTTP for the
# frontend. API_CORS_ORIGINS is comma-separated; include the frontend's dev
# and deployed origins (e.g. Vercel URL).
API_HOST=127.0.0.1
API_PORT=8080
API_CORS_ORIGINS=http://localhost:5173
